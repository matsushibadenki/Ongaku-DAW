{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ongaku DAW",
  "version": "0.1.0",
  "identifier": "app.ongaku.daw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ongaku DAW",
        "width": 1280,
        "height": 860,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
